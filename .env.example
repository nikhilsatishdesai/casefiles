# ---------------------------------------------------------------------------
# CASEFILES — environment
# Everything below is OPTIONAL. With no keys at all, the game runs complete:
# guest saves in the browser, the hand-authored season as nightly episodes.
# ---------------------------------------------------------------------------

# Supabase (global leaderboard + Google/GitHub/email sign-in).
# Create a project at https://supabase.com, run the SQL in README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI case generation (server-side only; pick any, or none for authored season).
# CASEFILES_AI_PROVIDER may force one of: mock | openai | anthropic | gemini
CASEFILES_AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
